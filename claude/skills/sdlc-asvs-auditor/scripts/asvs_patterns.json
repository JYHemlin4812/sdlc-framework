{
  "$comment": "OWASP ASVS patterns for SDLC. Projects can edit this file without touching the scanner.",
  "L1": [
    {
      "id": "ASVS-1.1",
      "name": "Hardcoded password",
      "regex": "(?i)(password|passwd|pwd)\\s*=\\s*['\"][^'\"]{4,}['\"]",
      "severity": "high",
      "extensions": [".py", ".js", ".ts", ".go", ".rs", ".env", ".yml", ".yaml"]
    },
    {
      "id": "ASVS-1.2",
      "name": "API key or secret in source",
      "regex": "(?i)(api[_-]?key|secret|token|bearer)\\s*=\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]",
      "severity": "high",
      "extensions": [".py", ".js", ".ts", ".go", ".rs", ".env"]
    },
    {
      "id": "ASVS-1.3",
      "name": "Weak hash MD5/SHA1",
      "regex": "\\b(md5|sha1)\\s*\\(",
      "severity": "high",
      "extensions": [".py", ".js", ".ts", ".go", ".rs"]
    },
    {
      "id": "ASVS-1.4",
      "name": "Use of eval/exec",
      "regex": "\\b(eval|exec)\\s*\\(",
      "severity": "high",
      "extensions": [".py", ".js", ".ts"]
    },
    {
      "id": "ASVS-1.5",
      "name": "SQL string concatenation",
      "regex": "(SELECT|INSERT|UPDATE|DELETE)\\s.*['\"]?\\s*\\+\\s*[a-zA-Z_]",
      "severity": "high",
      "extensions": [".py", ".js", ".ts", ".go", ".rs"]
    }
  ],
  "L2": [
    {
      "id": "ASVS-2.1",
      "name": "World-writable permission (chmod 777)",
      "regex": "chmod\\s+(0o)?777\\b",
      "severity": "medium",
      "extensions": [".py", ".sh", ".ps1"]
    },
    {
      "id": "ASVS-2.2",
      "name": "HTTP without TLS",
      "regex": "http://(?!localhost|127\\.0\\.0\\.1)",
      "severity": "medium",
      "extensions": [".py", ".js", ".ts", ".go", ".rs", ".yml", ".yaml", ".json"]
    },
    {
      "id": "ASVS-2.3",
      "name": "Flask POST without CSRF",
      "regex": "@app\\.route.*methods=\\[.*POST.*\\](?!.*csrf)",
      "severity": "medium",
      "extensions": [".py"]
    },
    {
      "id": "ASVS-2.4",
      "name": "Disabled SSL verification",
      "regex": "verify\\s*=\\s*False|rejectUnauthorized\\s*:\\s*false",
      "severity": "medium",
      "extensions": [".py", ".js", ".ts"]
    }
  ],
  "L3": [
    {
      "id": "ASVS-3.1",
      "name": "AES ECB mode (insecure)",
      "regex": "AES\\.new\\([^)]*MODE_ECB",
      "severity": "high",
      "extensions": [".py"]
    },
    {
      "id": "ASVS-3.2",
      "name": "Unsafe pickle deserialization",
      "regex": "pickle\\.load[s]?\\s*\\(",
      "severity": "high",
      "extensions": [".py"]
    },
    {
      "id": "ASVS-3.3",
      "name": "Subprocess shell=True",
      "regex": "subprocess\\.(?:Popen|run|call)\\s*\\([^)]*shell\\s*=\\s*True",
      "severity": "high",
      "extensions": [".py"]
    },
    {
      "id": "ASVS-3.4",
      "name": "Use of os.system",
      "regex": "\\bos\\.system\\s*\\(",
      "severity": "medium",
      "extensions": [".py"]
    }
  ]
}
