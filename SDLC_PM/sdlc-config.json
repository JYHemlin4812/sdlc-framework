{
  "$schema": "../claude/skills/sdlc/assets/sdlc-config.schema.json",
  "version": "3.2",
  "project_name": "sdlc-framework",
  "primary_language": "powershell",
  "secondary_languages": ["bash", "python"],
  "model_profile": "balanced",
  "model_overrides": {},
  "auto_approve": false,
  "asvs_level": 1,
